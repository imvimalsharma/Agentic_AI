        "# Manual Memory Management\n",
        "Manual memory management means you explicitly control what information is stored,\n",
        "retrieved, updated, and deleted from an AI agent's memory."
      ],
      "metadata": {
        "id": "nt8hyqqahSLt"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Example"
      ],
      "metadata": {
        "id": "h-GxgJLWhUw_"
      },
      "execution_count": 127,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from langgraph.store.memory import InMemoryStore"
      ],
      "metadata": {
        "id": "B5WKeo-okqX0"
      },
      "execution_count": 165,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def embed(texts: list[str]) -> list[list[float]]:\n",
        "    return [[1.0, 2.0] for _ in texts]"
      ],
      "metadata": {
        "id": "t3Ics4DZnZtA"
      },
      "execution_count": 169,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "store = InMemoryStore(index = {\"embed\":embed, \"dims\":2})"
      ],
      "metadata": {
        "id": "pFFQJrQjDJd6"
      },
      "execution_count": 172,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "store.put(\n",
        "    (\"user_memory\",),\n",
        "    \"a-memory\",\n",
        "    {\n",
        "        \"rules\": [\n",
        "            \"User likes short, direct language\",\n",
        "            \"User only speaks English & Python\"\n",
        "        ],\n",
