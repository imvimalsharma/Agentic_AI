        "import os\n",
        "import asyncio\n",
        "\n",
        "from langchain_groq import ChatGroq\n",
        "from langchain_core.tools import tool\n",
        "from langchain.agents import create_agent"
      ],
      "metadata": {
        "id": "u6jStWGttl6y"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "model = ChatGroq(\n",
        "    model=\"openai/gpt-oss-20b\",\n",
        "    api_key=os.environ[\"GROQ_API_KEY\"],\n",
        "    temperature=0\n",
        ")"
      ],
      "metadata": {
        "id": "Ldb_d6zKtYv2"
      },
      "execution_count": 23,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "@tool\n",
        "def search_information(query: str) -> str:\n",
        "    \"\"\"Provides factual information on a given topic.\"\"\"\n",
        "\n",
        "    print(f\"\\nTool called: search_information\")\n",
        "    print(f\"Query: {query}\")\n",
        "\n",
        "    simulated_results = {\n",
        "        \"weather in london\":\n",
        "            \"The weather in London is currently cloudy with a temperature of 15 C.\",\n",
        "\n",
        "        \"capital of france\":\n",
        "            \"The capital of France is Paris.\",\n",
        "\n",
        "        \"default\":\n",
        "            f\"Simulated search result for '{query}'. \"\n",
        "            \"No specific information was found.\"\n",
        "    }\n",
        "\n",
        "    result = simulated_results.get(\n",
        "        query.lower(),\n",
        "        simulated_results[\"default\"]\n",
        "    )\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "tools = [search_information]"
      ],
      "metadata": {
        "id": "jpneRyE_tkMm"
      },
      "execution_count": 24,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "agent = create_agent(\n",
        "    model=model,\n",
        "    tools=tools,\n",
        "    system_prompt=\"You are a helpful assistant. Use the available tools when needed.\"\n",
        ")"
      ],
      "metadata": {
        "id": "pCnrDgdVw7Sg"
      },
      "execution_count": 25,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "async def run_agent_with_tool(query: str):\n",
        "\n",
        "    try:\n",
        "\n",
        "        response = await agent.ainvoke({\n",
        "            \"messages\": [\n",
        "                {\n",
        "                    \"role\": \"user\",\n",
        "                    \"content\": query\n",
        "                }\n",
        "            ]\n",
        "        })\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 60)\n",
        "        print(\"QUERY:\", query)\n",
        "        print(\"FINAL RESPONSE:\")\n",
        "        print(response[\"messages\"][-1].content)\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error running agent: {e}\")\n"
      ],
      "metadata": {
        "id": "vZFIbN70w-Fe"
      },
      "execution_count": 26,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "async def main():\n",
        "\n",
        "    tasks = [\n",
        "        run_agent_with_tool(\n",
        "            \"What is the capital of France?\"\n",
        "        ),\n",
        "        run_agent_with_tool(\n",
        "            \"What is the weather like in London?\"\n",
        "        ),\n",
        "        run_agent_with_tool(\n",
        "            \"What is the weather like in London?\"\n",
        "        )\n",
        "    ]\n",
        "\n",
        "    await asyncio.gather(*tasks)"
      ],
      "metadata": {
        "id": "YD4dLwJlxB9v"
      },
      "execution_count": 27,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "await main()"
      ],
